# --- core ---
NODE_ENV=development
PORT=4000
# Set to 1 only when running behind a single trusted reverse proxy.
TRUST_PROXY=false
DATABASE_URL=postgresql://puo:puo@localhost:5432/puo?schema=public

# --- auth ---
# 32+ random bytes, base64 or hex. Generate: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-0000000000000000000000000000000000
ISSUER=puo-api
AUDIENCE=puo-mobile
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- cors ---
# Comma separated origins for any browser client. Native apps do not need CORS.
CORS_ORIGINS=

# --- media / public ---
PUBLIC_API_URL=http://localhost:4000
MEDIA_BASE_URL=http://localhost:4000/media

# --- google sign in ---
# Comma separated OAuth client ids accepted as ID token audiences.
GOOGLE_CLIENT_IDS=

# --- email (deferred) ---
# console | disabled | resend (resend not wired until a provider exists)
EMAIL_TRANSPORT=console
EMAIL_FROM=Puo <hello@example.com>
RESEND_API_KEY=

# --- push ---
PUSH_ENABLED=false

# --- admin bootstrap ---
ALLOW_ADMIN_SEED=true
